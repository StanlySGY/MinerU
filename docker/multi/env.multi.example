# =============================================================================
# MinerU 多卡部署配置
# =============================================================================

# ========== VLM Server 配置 ==========
MINERU_MODEL_SOURCE=local
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B
VLLM_GPU_MEMORY_UTILIZATION=0.9
OMP_NUM_THREADS=1

# ========== VLM 端口（每张卡一个） ==========
VLM_1_PORT=30000
VLM_2_PORT=30001
VLM_3_PORT=30002

# ========== API 端口（每组一个） ==========
API_1_PORT=18000
API_2_PORT=18001
API_3_PORT=18002

# ========== Router 端口 ==========
ROUTER_PORT=8002

# ========== API 服务器 IP ==========
# 如果所有 API 在同一台机器，填 127.0.0.1
# 如果分布在不同机器，分别填写
API_1_IP=127.0.0.1
API_2_IP=127.0.0.1
API_3_IP=127.0.0.1

# ========== API 性能配置 ==========
MINERU_PROCESSING_WINDOW_SIZE=32
MINERU_API_MAX_CONCURRENT_REQUESTS=3
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_LOG_LEVEL=INFO
