# =============================================================================
# MinerU 多卡部署配置
# =============================================================================

# ========== VLM Server 配置（已有的 VLM Server 地址） ==========
# VLM Server IP 和端口（指向你已启动的 VLM Server）
VLM_1_IP=10.8.132.224
VLM_1_PORT=6002

# VLM 模型名称（需与 VLM Server 一致）
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ========== VLM 端口（已注释，由用户自行管理） ==========
# VLM_1_PORT=30000
# VLM_2_PORT=30001
# VLM_3_PORT=30002

# ========== NPU 卡号（已注释，由用户自行管理） ==========
# VLM_1_ASCEND_DEVICE=0
# VLM_2_ASCEND_DEVICE=1
# VLM_3_ASCEND_DEVICE=2

# ========== API 端口（每组一个） ==========
API_1_PORT=18000
API_2_PORT=18001
API_3_PORT=18002

# ========== Router 端口 ==========
ROUTER_PORT=8002

# ========== API 服务器 IP ==========
# 如果所有 API 在同一台机器，填 127.0.0.1
# 如果分布在不同机器，分别填写
API_1_IP=127.0.0.1
API_2_IP=127.0.0.1
API_3_IP=127.0.0.1

# ========== API 性能配置 ==========
MINERU_PROCESSING_WINDOW_SIZE=32
MINERU_API_MAX_CONCURRENT_REQUESTS=3
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_LOG_LEVEL=INFO
