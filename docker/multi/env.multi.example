# =============================================================================
# MinerU 多实例部署配置（3 个 API + Router，VLM 为外部服务）
# =============================================================================

# ========== 镜像配置 ==========
MINERU_ENV_IMAGE=mineru-env:v1.0
MINERU_CODE_IMAGE=mineru-code:v1.0

# ========== 三个 VLM Server 地址 ==========
VLM_1_IP=10.8.132.224
VLM_1_PORT=30000
VLM_2_IP=10.8.132.225
VLM_2_PORT=30000
VLM_3_IP=10.8.132.226
VLM_3_PORT=30000
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ========== API 端口 ==========
API_1_PORT=18000
API_2_PORT=18001
API_3_PORT=18002

# ========== Router 端口 ==========
ROUTER_PORT=8002

# ========== Router 后端使用容器网络，不需要填写 API IP ==========

# ========== API 性能配置 ==========
MINERU_PROCESSING_WINDOW_SIZE=32
MINERU_API_MAX_CONCURRENT_REQUESTS=3
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_LOG_LEVEL=INFO
