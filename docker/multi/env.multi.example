# =============================================================================
# MinerU 当前部署配置（1 个外部 VLM + 1 个 API + Router）
#
# 本目录暂时只启动 API-1 和 Router。API-2/API-3、VLM-2/VLM-3 已在
# compose-multi.yaml 中注释，等后续增加 VLM 后再启用。
# =============================================================================

# ========== 镜像配置 ==========
# 这两个标签必须和 docker image ls 中已导入的标签完全一致。
# mineru-env 必须与本机 CPU 架构和加速卡匹配：
#   麒麟 ARM64 + Ascend NPU -> mineru-env:npu-v1.0
#   x86_64 纯 CPU / ARM64 纯 CPU -> 使用对应架构自行构建的 CPU 版镜像
MINERU_ENV_IMAGE=mineru-env:npu-v1.0
MINERU_CODE_IMAGE=mineru-code:v3.4.2
# 使用独立卷，避免和其他部署互相覆盖代码。
MINERU_CODE_VOLUME=mineru-code-multi

# ========== 运维控制台 ==========
# 状态页面：http://服务器IP:19000
MINERU_OPS_PORT=19000
# 批量测试只允许读取该宿主机目录，建议放在容量充足的数据盘。
MINERU_OPS_TEST_HOST_PATH=./test-pdfs
# 页面历史记录、批量报告和审计日志使用独立 Docker 卷。
MINERU_OPS_DATA_VOLUME=mineru-ops-data-multi
# 留空时可以只读查看状态，但禁止启动、停止、重启和批量测试。
# 现场部署前请改成足够长的随机字符串，并通过管理令牌输入框使用。
MINERU_OPS_AUTH_TOKEN=
# 一键端到端测试使用的后端。需要同时验证外部 VLM 时保持 vlm-http-client。
MINERU_OPS_SMOKE_BACKEND=vlm-http-client
MINERU_OPS_SMOKE_TIMEOUT_SECONDS=900
# 浏览器一次上传的 PDF 总大小上限，单位 MB。
MINERU_OPS_MAX_UPLOAD_MB=2048
# 原始 PDF 和提取预览产物的保留天数；0 表示不自动清理。
MINERU_OPS_ARTIFACT_RETENTION_DAYS=7
# 原始 PDF 和提取预览产物允许占用的总空间，单位 GB。
MINERU_OPS_ARTIFACT_MAX_GB=50
# 是否在诊断结果 ZIP 中保存提取图片；关闭可显著减少磁盘占用。
MINERU_OPS_SAVE_RESULT_IMAGES=true
# API 输出目录必须位于可写卷中，不要改成 /app/output。
MINERU_API_OUTPUT_ROOT=/var/lib/mineru/output
MINERU_API_OUTPUT_VOLUME=mineru-api-output-multi

# ========== Pipeline / Hybrid 本地模型（必须准备） ==========
# 宿主机上的完整 PDF-Extract-Kit-1.0 根目录。目录内必须直接包含 models/。
# 默认值对应本目录下的 models/PDF-Extract-Kit-1.0；也可以改成绝对路径。
PIPELINE_MODEL_HOST_PATH=./models/PDF-Extract-Kit-1.0
# 宿主机上的 JSON 配置文件。默认使用本目录提供的 mineru.pipeline.json。
PIPELINE_CONFIG_HOST_PATH=./mineru.pipeline.json
# 容器内固定路径，不要改；必须与 mineru.pipeline.json 中 models-dir.pipeline 一致。
MINERU_TOOLS_CONFIG_JSON=/etc/mineru/mineru.json
# 只使用本地文件，禁止 Pipeline/Hybrid 启动时联网下载。
MINERU_MODEL_SOURCE=local
# 设备模式，决定 start-multi.sh 叠加哪个硬件映射文件：
#   cpu  = 不映射任何加速卡，适用于 x86_64 和 ARM 纯 CPU 主机（不需要 /dev/davinci*）
#   npu  = 叠加 compose-multi.npu.yaml，映射 Ascend NPU 和宿主机驱动
#   cuda = 叠加 compose-multi.nvidia.yaml，需要 NVIDIA Container Toolkit
# 麒麟 NPU 现场使用 npu；纯 CPU 主机改成 cpu 即可，其他配置不需要改。
MINERU_DEVICE_MODE=npu
# 仅 MINERU_DEVICE_MODE=npu 时生效：指定宿主机物理 NPU 卡号。
# 这里绑定 6 号卡；容器内对应的设备索引为 npu:0。
# compose-multi.npu.yaml 会映射 /dev/davinci6，并把该值传给
# ASCEND_RT_VISIBLE_DEVICES，实现设备挂载和进程可见设备限制。
PIPELINE_NPU_ID=6

# ========== VLM Server 地址（使用 hybrid/vlm 后端时必须修改） ==========
# 只填写 IP/域名和端口，不要加 http:// 或 /v1。
# API 容器必须能访问这个地址；部署前先从 API 主机执行：
# curl http://VLM_IP:VLM_PORT/v1/models
# 只用 backend=pipeline 时可以留空，此时会跳过 VLM 连通性检查。
VLM_1_IP=10.8.132.224
VLM_1_PORT=30000
# VLM-2/VLM-3 暂未部署，保持注释。
# VLM_2_IP=10.8.132.225
# VLM_2_PORT=30000
# VLM_3_IP=10.8.132.226
# VLM_3_PORT=30000
# 必须和 VLM 的 /v1/models 返回的模型名称一致。
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ========== API 端口 ==========
# 客户端可访问 http://本机IP:18000/docs。
API_1_PORT=18000
# API-2/API-3 暂未启动。
# API_2_PORT=18001
# API_3_PORT=18002

# ========== Router 端口 ==========
ROUTER_PORT=8002

# Router 后端使用容器网络，不需要填写 API IP。

# ========== API 性能配置 ==========
# Ascend 910B 建议从 8 开始；NVIDIA 环境稳定后可单独调回 16/32。
MINERU_PROCESSING_WINDOW_SIZE=8
# 单 VLM 首次部署建议先使用 1，确认稳定后再提高。
MINERU_API_MAX_CONCURRENT_REQUESTS=1
# VLM HTTP Client 在单页超时时跳过该页并继续处理，避免一张慢页导致整份 PDF 失败。
MINERU_VLM_FAILURE_POLICY=skip_page
# 所有并行文件和任务共享的 VLM 页面并发上限；NPU 建议先用 2，稳定后再按实测调整。
MINERU_VLM_GLOBAL_PAGE_CONCURRENCY=2

# ========== 运维控制台慢页测试相关配置 ==========
# 普通 API 请求未单独传参时使用的“单页软超时”（秒），默认 600 秒。
# 运维控制台创建批量测试时可以在页面上临时改成 900、1200 等，不需要每次修改 env.multi。
# 控制台允许填写 1-7200；用于首次排查时建议从 600 开始逐级增加。
MINERU_VLM_PAGE_TIMEOUT_SECONDS=600

# 普通 API 请求遇到连接中断、502/503/504 等瞬时错误时，最多重试多少次。
# 运维控制台的批量测试会单独传 page_connect_max_retries，默认填 0，便于测出不含重试的真实耗时。
# 现场排障建议先保持 1；如需测试重试影响，请优先在控制台按批次调整，不必反复改此文件。
MINERU_VLM_CONNECT_MAX_RETRIES=1

# MinerUClient 内部区域请求并发；NPU 建议从 4 开始。
MINERU_VLM_CLIENT_MAX_CONCURRENCY=4
# 底层 HTTP Client 自己的自动重试次数。这里必须保持 0，避免和上面的页级重试叠加。
MINERU_VLM_CLIENT_MAX_RETRIES=0
# 底层 HTTP 连接的“硬超时”（秒）。它必须大于或等于控制台准备测试的最大单页软超时。
# 本次设为 7200，表示控制台可把单页 soft timeout 提高到最多 7200 秒，而不会先被旧的 600 秒 HTTP 超时断开。
# 修改该值后必须重新创建 mineru-api-1 容器；只执行 docker restart 不会更新容器启动参数。
MINERU_VLM_CLIENT_HTTP_TIMEOUT=7200

# 说明：page_timeout_seconds、page_connect_max_retries、vlm_batch_size 是运维控制台每个批次的输入参数，
# 不需要在 env.multi 中新增同名变量。vlm_batch_size 建议依次测试 1、2、4；默认 1，允许范围 1-16。
# 控制台“重试异常页”也会按新批次传入这些值，例如把原 600 秒超时改为 1200 秒；这里的 hard timeout 仍必须不小于弹窗填写值。
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_LOG_LEVEL=INFO
