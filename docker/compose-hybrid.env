# =============================================================================
# MinerU Hybrid 模式配置
# =============================================================================

# ========== 服务器 IP 配置 ==========
# VLM 推理服务器 IP（NPU 所在机器）
VLM_SERVER_IP=10.8.132.224

# API 服务器 IP（运行 mineru-api + Pipeline 模型的机器）
API_SERVER_IP=127.0.0.1

# ========== 端口配置 ==========
# VLM Server 端口（每张 NPU 卡一个端口）
VLM_1_PORT=30000
VLM_2_PORT=30001
VLM_3_PORT=30002

# API Server 端口
API_1_PORT=18000
API_2_PORT=18001
API_3_PORT=18002

# Router 端口
ROUTER_PORT=8002

# ========== 模型配置 ==========
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ========== 性能配置 ==========
# 每个窗口处理的页数
MINERU_PROCESSING_WINDOW_SIZE=32

# 每个 API 实例的最大并发请求数
# hybrid 模式下 Pipeline 模型也要跑，建议比纯 vlm 低一些
MINERU_API_MAX_CONCURRENT_REQUESTS=3

# ========== 功能配置 ==========
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ========== 日志配置 ==========
MINERU_LOG_LEVEL=INFO
