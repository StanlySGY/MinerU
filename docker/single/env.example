# =============================================================================
# MinerU 统一配置文件
# =============================================================================

# ========== 镜像配置 ==========
MINERU_ENV_IMAGE=mineru-env:v1.0
MINERU_CODE_IMAGE=mineru-code:v1.0
MINERU_VLM_IMAGE=mineru-server:v1.0

# ========== VLM Server 配置 ==========
# 硬件类型：nvidia 或 ascend
VLM_DEVICE_TYPE=ascend

# VLM 服务器 IP（如果 VLM 和 API 同机，填 127.0.0.1）
VLM_SERVER_IP=127.0.0.1

# VLM 服务端口
VLM_PORT=30000

# 模型来源：local / modelscope / huggingface
MINERU_MODEL_SOURCE=local

# VLM 镜像使用的推理引擎：auto / vllm / lmdeploy
VLM_ENGINE=auto

# 离线模型在宿主机和容器中的路径
VLM_MODEL_HOST_PATH=./models
VLM_MODEL_PATH=/models/mineru

# Ascend NPU 卡号
ASCEND_DEVICE=0

# VLM 模型名称
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# GPU/NPU 显存利用率（0.1-1.0）
VLLM_GPU_MEMORY_UTILIZATION=0.9

OMP_NUM_THREADS=1

# ========== API Server 配置 ==========
# API 服务端口
API_PORT=18000

# 每个窗口处理的页数
MINERU_PROCESSING_WINDOW_SIZE=32

# 最大并发请求数
MINERU_API_MAX_CONCURRENT_REQUESTS=3

# 启用公式解析
MINERU_FORMULA_ENABLE=true

# 启用表格解析
MINERU_TABLE_ENABLE=true

# 日志级别
MINERU_LOG_LEVEL=INFO
