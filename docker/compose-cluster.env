# =============================================================================
# MinerU 集群部署配置
# =============================================================================
# 使用前请修改以下 IP 地址为你实际的服务器地址
# =============================================================================

# ========== 服务器 IP 配置 ==========
# VLM 推理服务器 IP（NPU 所在机器）
# 如果所有 NPU 都在同一台机器上，填同一个 IP
# 如果分布在不同机器上，分别填写
VLM_SERVER_1_IP=10.8.132.224
VLM_SERVER_2_IP=10.8.132.224
VLM_SERVER_3_IP=10.8.132.224

# API 服务器 IP（运行 mineru-api 的机器，可以和 VLM 同机也可以不同）
API_SERVER_1_IP=127.0.0.1

# ========== 端口配置 ==========
# VLM Server 端口（每张 NPU 卡一个端口）
VLM_1_PORT=30000
VLM_2_PORT=30001
VLM_3_PORT=30002

# API Server 端口（每个 API 实例一个端口）
API_1_PORT=18000
API_2_PORT=18001
API_3_PORT=18002

# Router 端口（统一入口）
ROUTER_PORT=8002

# ========== 模型配置 ==========
MINERU_MODEL_SOURCE=modelscope
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-Pro-2604-1.2B

# ========== VLM 性能配置 ==========
# GPU/NPU 显存利用率（0.1-1.0，越大并发越强）
VLLM_GPU_MEMORY_UTILIZATION=0.9

# OMP 线程数（vllm 推荐 1）
OMP_NUM_THREADS=1

# ========== API 性能配置 ==========
# 每个窗口处理的页数（越小单次内存占用越低，处理越频繁）
MINERU_PROCESSING_WINDOW_SIZE=32

# 最大并发请求数（每个 API 实例能同时处理的文档数）
MINERU_API_MAX_CONCURRENT_REQUESTS=6

# ========== 功能配置 ==========
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true

# ========== 日志配置 ==========
MINERU_LOG_LEVEL=INFO
