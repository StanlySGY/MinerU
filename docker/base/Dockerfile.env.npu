# =============================================================================
# MinerU Ascend NPU runtime image - dependencies only, no MinerU source/models
# =============================================================================
# The base image must be an ARM64 Ascend PyTorch image compatible with the
# target host's CANN/driver versions and must already contain torch_npu.
# =============================================================================

ARG NPU_BASE_IMAGE
FROM ${NPU_BASE_IMAGE}

ARG MINERU_DEPENDENCY_VERSION=3.4.2

USER root

# This Dockerfile targets the Ubuntu/Debian based official Ascend PyTorch image.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        curl && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# A CPU-only ARM build host does not provide libascend_hal.so, so validate the
# installed torch-npu distribution without importing its hardware extension.
RUN TORCH_DEVICE_BACKEND_AUTOLOAD=0 python -c 'from importlib.metadata import version as dist_version; from packaging.version import Version; import torch; version = Version(torch.__version__.split("+")[0]); assert Version("2.6.0") <= version < Version("3.0.0"), f"MinerU requires torch>=2.6,<3, found {torch.__version__}"; print("base torch:", torch.__version__); print("base torch_npu package:", dist_version("torch-npu"))'

# Resolve the released Pipeline dependency set, then remove only the MinerU
# package. Runtime source is supplied by the separate mineru-code image.
RUN python -m pip install --no-cache-dir \
        six \
        "mineru[pipeline]==${MINERU_DEPENDENCY_VERSION}" \
        -i https://mirrors.aliyun.com/pypi/simple && \
    python -m pip uninstall -y mineru

# Pip must not remove the base image's torch-npu package. Hardware import and
# tensor allocation are verified later on the offline NPU host.
RUN TORCH_DEVICE_BACKEND_AUTOLOAD=0 python -c 'from importlib.metadata import version as dist_version; import torch, torchvision; print("final torch:", torch.__version__); print("final torch_npu package:", dist_version("torch-npu")); print("final torchvision:", torchvision.__version__)'

WORKDIR /app

ENV PYTHONPATH=/app
