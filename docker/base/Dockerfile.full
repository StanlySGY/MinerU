# 基于 python:3.11-slim，安装 mineru[pipeline]
# 支持所有 backend：pipeline / vlm-http-client / hybrid-http-client
# 纯 CPU 部署，VLM 推理走远程 HTTP

FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        curl && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir six 'mineru[pipeline]>=3.0.0' -i https://mirrors.aliyun.com/pypi/simple
