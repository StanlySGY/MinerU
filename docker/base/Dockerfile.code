# =============================================================================
# MinerU 代码镜像 - 只携带源码，不包含运行环境
# =============================================================================
# 构建上下文必须是仓库根目录。
# docker build -t mineru-code:v1.0 -f docker/base/Dockerfile.code .
# =============================================================================

FROM busybox:1.37.0-musl

COPY mineru /payload/mineru
COPY pyproject.toml /payload/pyproject.toml

# Compose 将 /target 挂载为共享代码卷。每次启动同步服务时先清理旧代码，
# 确保源码中已经删除的文件不会残留在离线环境。
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["rm -rf /target/* /target/.[!.]* /target/..?* 2>/dev/null || true; cp -a /payload/. /target/"]
