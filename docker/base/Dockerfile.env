# =============================================================================
# MinerU 环境镜像 - 只包含依赖，不含代码
# =============================================================================
# 构建一次，长期使用。离线部署时只需更新代码镜像。
#
# 构建：DOCKER_BUILDKIT=0 docker build -t mineru-env:v1.0 -f Dockerfile.env .
# =============================================================================

FROM python:3.11-slim

# 系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        curl && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Python 依赖（mineru[pipeline] 包含 torch、paddleocr 等）
RUN pip install --no-cache-dir six 'mineru[pipeline]>=3.0.0' -i https://mirrors.aliyun.com/pypi/simple

# 工作目录
WORKDIR /app
