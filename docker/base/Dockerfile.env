# =============================================================================
# MinerU 运行环境镜像 - 只包含系统和 Python 依赖
# =============================================================================
# 构建一次，长期使用。离线部署时只需更新代码镜像。
#
# 构建：DOCKER_BUILDKIT=0 docker build -t mineru-env:v1.0 -f Dockerfile.env .
# =============================================================================

FROM python:3.11-slim

ARG MINERU_DEPENDENCY_VERSION=3.4.2

# 系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        curl && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 通过已发布的 MinerU extra 解析官方依赖，再移除包本身。
# 运行时源码由独立的 mineru-code 镜像同步到 /app。
RUN pip install --no-cache-dir \
        six \
        "mineru[pipeline]==${MINERU_DEPENDENCY_VERSION}" \
        -i https://mirrors.aliyun.com/pypi/simple && \
    pip uninstall -y mineru

WORKDIR /app

ENV PYTHONPATH=/app
