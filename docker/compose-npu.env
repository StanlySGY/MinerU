# =============================================================================
# MinerU 910B NPU 服务器配置
# =============================================================================

# ========== 模型配置 ==========
# 模型来源：local / modelscope / huggingface（默认：local）
MINERU_MODEL_SOURCE=modelscope

# VLM 模型路径（默认：OpenDataLab/MinerU2.5-2509-1.2B）
# 自定义模型请设置完整模型路径或名称
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-2509-1.2B

# ========== 网络配置 ==========
# VLM 推理服务端口（默认：30000）
MINERU_VLM_PORT=30000

# ========== 性能配置 ==========
# GPU/NPU 显存利用率（默认：0.9）
# 越大 = KV 缓存越大 = 并发能力越强
VLLM_GPU_MEMORY_UTILIZATION=0.9

# 最大序列长度（取消注释以覆盖模型默认值）
# VLLM_MAX_MODEL_LEN=8192

# 多 NPU 张量并行数（默认：1）
# VLLM_TENSOR_PARALLEL_SIZE=1

# ========== 日志配置 ==========
# 日志级别：DEBUG、INFO、WARNING、ERROR（默认：INFO）
MINERU_LOG_LEVEL=INFO

# ========== 昇腾 NPU 专属配置 ==========
# OMP 线程数（默认：1，vllm 推荐）
OMP_NUM_THREADS=1

# ========== 高级选项（取消注释启用） ==========
# 禁用 torch NPU 异步（调试时使用）
# ASCEND_LAUNCH_BLOCKING=1
