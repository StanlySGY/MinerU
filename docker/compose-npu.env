# =============================================================================
# MinerU 910B NPU Server Configuration
# =============================================================================

# ========== Model Configuration ==========
# Model source: local / modelscope / huggingface (default: local)
MINERU_MODEL_SOURCE=modelscope

# VLM model path (default: OpenDataLab/MinerU2.5-2509-1.2B)
# For custom model, set the full model path or name
MINERU_VLM_MODEL=OpenDataLab/MinerU2.5-2509-1.2B

# ========== Network Configuration ==========
# VLM inference server port (default: 30000)
MINERU_VLM_PORT=30000

# ========== Performance Configuration ==========
# GPU/NPU memory utilization ratio (default: 0.9)
# Higher = more memory for KV cache = better concurrency
VLLM_GPU_MEMORY_UTILIZATION=0.9

# Max sequence length (uncomment to override model default)
# VLLM_MAX_MODEL_LEN=8192

# Tensor parallel size for multi-NPU (default: 1)
# VLLM_TENSOR_PARALLEL_SIZE=1

# ========== Logging ==========
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
MINERU_LOG_LEVEL=INFO

# ========== Ascend NPU Specific ==========
# OMP threads (default: 1 for vllm)
OMP_NUM_THREADS=1

# ========== Advanced Options (uncomment to enable) ==========
# Disable torch NPU async (if needed for debugging)
# ASCEND_LAUNCH_BLOCKING=1
